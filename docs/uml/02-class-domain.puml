@startuml Square_One_Chess_Domain_Classes
skinparam dpi 200
hide circle
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam arrowColor #000000
left to right direction
title Class diagram --- Domain model

class User {
  +id: String
  +email: String
  +username: String
  +password: String
  +emailVerified: Boolean
  +elo: Int
  +eloBullet: Int
  +eloBlitz: Int
  +eloRapid: Int
  +gamesPlayed: Int
  +gamesWon: Int
}
class Administrator {
  --
  +viewPlatformAnalytics()
}

abstract class Game {
  +id: String
  +status: String
  +fen: String
  +pgn: String
  +timeControl: String
}
class OnlineGame {
}
class BotGame {
  +botDifficulty: String
}
class Move {
  +moveNumber: Int
  +fromSquare: String
  +toSquare: String
  +fen: String
}
class QueueEntry {
  +elo: Int
  +joinedAt: DateTime
}
class Friend {
  +status: String
}

abstract class ChatMessage {
  +roomId: String
  +content: String
}
class PrivateMessage {
}
class GameMessage {
}
class GlobalMessage {
}

abstract class Tournament {
  +name: String
  +type: String
  +maxPlayers: Int
  +status: String
  +currentRound: Int
}
class SingleElimination {
  {static} +ALLOWED_SIZES: 2 | 4 | 8 | 16 | 32
  --
  +pairFirstRound()
  +advanceWinners()
}
class RoundRobin {
  {static} +PLAYER_COUNT: even, 2..16
  --
  +buildFullSchedule()
  +activateNextRound()
}
class TournamentRegistration {
  +joinDate: DateTime
}
class TournamentMatch {
  +round: Int
  +matchIndex: Int
  +status: String
}
class TournamentMessage {
  +body: String
}

class Puzzle {
  +fen: String
  +moves: String
  +theme: String
  +rating: Int
}
class DailyPuzzle {
  +date: DateTime
}
class UserPuzzleStats {
  +solved: Boolean
  +attempts: Int
}

User <|-- Administrator
Game <|-- OnlineGame
Game <|-- BotGame
ChatMessage <|-- PrivateMessage
ChatMessage <|-- GameMessage
ChatMessage <|-- GlobalMessage
Tournament <|-- SingleElimination
Tournament <|-- RoundRobin

User "1" -- "*" OnlineGame : white
User "1" -- "*" OnlineGame : black
User "1" -- "*" BotGame : plays
Game "1" *-- "*" Move : contains
User "1" *-- "*" QueueEntry : queued as
User "1" -- "*" Friend : sent
User "1" -- "*" Friend : received
User "1" -- "*" ChatMessage : sent
User "1" -- "*" PrivateMessage : received
User "1" -- "*" Tournament : creates
Tournament "1" *-- "*" TournamentRegistration : has
User "1" -- "*" TournamentRegistration : joins
Tournament "1" *-- "*" TournamentMatch : has
Tournament "1" *-- "*" TournamentMessage : has
User "1" -- "*" TournamentMessage : sent
TournamentMatch "0..1" -- "0..1" Game : played as
Puzzle "1" *-- "*" DailyPuzzle : scheduled as
Puzzle "1" *-- "*" UserPuzzleStats : tracks
User "1" -- "*" UserPuzzleStats : records

@enduml
