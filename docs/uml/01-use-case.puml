@startuml Square_One_Chess_Use_Cases
skinparam dpi 160
skinparam wrapWidth 90
skinparam maxMessageSize 60
skinparam nodesep 14
skinparam ranksep 22
skinparam linetype polyline
left to right direction
hide empty description
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #000000
skinparam actorBorderColor #000000
skinparam rectangleBorderColor #000000
skinparam arrowColor #000000
skinparam packageStyle rectangle
title Global use-case diagram\nSquare One Chess

actor "Visitor" as Guest
actor "Player" as Player

rectangle "Square One Chess" {
  usecase "Log in" as UC_Login
  usecase "Register" as UC_Register
  usecase "Manage profile" as UC_Profile
  usecase "Play online games" as UC_Play
  usecase "View and replay games" as UC_History
  usecase "Review a finished game" as UC_Review
  usecase "Solve puzzles" as UC_Puzzles
  usecase "Take part in tournaments" as UC_Tournament
  usecase "Manage friends and chat" as UC_Social
  usecase "View the leaderboard" as UC_Leaderboard
  usecase "View dashboard statistics" as UC_Stats
  usecase "View platform analytics" as UC_Admin
}

actor "Administrator" as Admin

Guest -- UC_Register
Guest -- UC_Login

Player -- UC_Login
Player -- UC_Profile
Player -- UC_Play
Player -- UC_History
Player -- UC_Puzzles
Player -- UC_Review
Player -- UC_Tournament
Player -- UC_Social
Player -- UC_Leaderboard
Player -- UC_Stats

UC_Admin -- Admin
UC_Login -- Admin

UC_Profile ..> UC_Login : <<include>>
UC_Play ..> UC_Login : <<include>>
UC_History ..> UC_Login : <<include>>
UC_Puzzles ..> UC_Login : <<include>>
UC_Review ..> UC_Login : <<include>>
UC_Tournament ..> UC_Login : <<include>>
UC_Social ..> UC_Login : <<include>>
UC_Leaderboard ..> UC_Login : <<include>>
UC_Stats ..> UC_Login : <<include>>
UC_Admin ..> UC_Login : <<include>>

UC_Review ..> UC_History : <<extend>>

@enduml
