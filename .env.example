PORT=3000
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-min-16-chars
JWT_EXPIRES_IN=7d

# Auth / email (local dev)
REQUIRE_EMAIL_VERIFICATION=false
DEV_AUTO_VERIFY_EMAIL=true
FRONTEND_URL=http://localhost:4200
APP_URL=http://localhost:3000

# Production SMTP (optional in dev — links are logged to console if unset)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Square One <noreply@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
